@@ -35,6 +35,45 @@
 
 #ifdef HAVE_MAGIC
 
+#ifdef __linux__
+/**
+ * \brief Find a magic.mgc bundled with the suricata executable.
+ *
+ * Self-contained packages ship the database built by the same libmagic
+ * version Suricata is linked against. The system default database may be
+ * missing or in a format this libmagic cannot read.
+ *
+ * Looks for <exe dir>/magic.mgc, then <exe dir>/../etc/magic.mgc.
+ *
+ * \retval buf with the path, or NULL if there is no bundled database
+ */
+static const char *MagicBundledFile(char *buf, size_t size)
+{
+    static const char *candidates[] = { "magic.mgc", "../etc/magic.mgc" };
+    char exe[PATH_MAX];
+    ssize_t len = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+    if (len <= 0) {
+        return NULL;
+    }
+    exe[len] = '\0';
+    char *slash = strrchr(exe, '/');
+    if (slash == NULL) {
+        return NULL;
+    }
+    *slash = '\0';
+    for (size_t i = 0; i < ARRAY_SIZE(candidates); i++) {
+        int written = snprintf(buf, size, "%s/%s", exe, candidates[i]);
+        if (written < 0 || (size_t)written >= size) {
+            continue;
+        }
+        if (access(buf, R_OK) == 0) {
+            return buf;
+        }
+    }
+    return NULL;
+}
+#endif
+
