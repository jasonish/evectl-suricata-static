# Pinned versions for the portable Suricata Linux builds.
#
# Bump SURICATA_VERSION (and its checksum) when a new 8.0.x release is
# published. Bump PACKAGE_RELEASE when re-packaging the same Suricata
# version (new patch, dependency refresh, packaging fix). Reset it to 1
# when SURICATA_VERSION changes.
#
# The release tag is ${SURICATA_VERSION}-${PACKAGE_RELEASE}, e.g. 8.0.8-1.

SURICATA_VERSION=8.0.8
SURICATA_SHA256=bb56bbaeb4da81b4c90e61148f93b789ea924412207388bc9cba0a7ac6a24a8f
SURICATA_URL=https://www.openinfosecfoundation.org/download/suricata-${SURICATA_VERSION}.tar.gz

PACKAGE_RELEASE=1

# Build environments. The "gnu" variant links only glibc dynamically and
# is built on manylinux_2_28 (AlmaLinux 8, glibc 2.28) so it runs on any
# distribution with glibc >= 2.28. The "musl" variant is fully static.
# The architecture suffix (_x86_64, _aarch64) is appended to GNU_IMAGE.
GNU_IMAGE=quay.io/pypa/manylinux_2_28
MUSL_IMAGE=docker.io/library/alpine:3.24
GLIBC_BASELINE=2.28

# Rust toolchain installed with rustup in both build images.
RUST_VERSION=1.99.1

# Ragel 6 is needed to build Vectorscan; Ragel 7 is incompatible and is
# all that EPEL 8 offers, so the gnu image builds it from source.
RAGEL_VERSION=6.10
RAGEL_SHA256=5f156edb65d20b856d638dd9ee2dfb43285914d9aa2b6ec779dac0270cd56c3f
RAGEL_URL=https://www.colm.net/files/ragel/ragel-${RAGEL_VERSION}.tar.gz

# Libraries built from source and linked statically into suricata. The
# same versions are used for both variants.
ZLIB_VERSION=1.3.2
ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
ZLIB_URL=https://github.com/madler/zlib/releases/download/v${ZLIB_VERSION}/zlib-${ZLIB_VERSION}.tar.gz

LZ4_VERSION=1.10.0
LZ4_SHA256=537512904744b35e232912055ccf8ec66d768639ff3abe5788d90d792ec5f48b
LZ4_URL=https://github.com/lz4/lz4/releases/download/v${LZ4_VERSION}/lz4-${LZ4_VERSION}.tar.gz

PCRE2_VERSION=10.49
PCRE2_SHA256=929f0b20e62879252a15886b06c89f1edef61a363cbd5826fb041080a5e557ae
PCRE2_URL=https://github.com/PCRE2Project/pcre2/releases/download/pcre2-${PCRE2_VERSION}/pcre2-${PCRE2_VERSION}.tar.gz

JANSSON_VERSION=2.15.1
JANSSON_SHA256=0c7114dc0b2d22a670724a1f95922029d7077c19dbf79a584cb8084d2f267f2f
JANSSON_URL=https://github.com/akheron/jansson/releases/download/v${JANSSON_VERSION}/jansson-${JANSSON_VERSION}.tar.gz

LIBYAML_VERSION=0.2.5
LIBYAML_SHA256=c642ae9b75fee120b2d96c712538bd2cf283228d2337df2cf2988e3c02678ef4
LIBYAML_URL=https://github.com/yaml/libyaml/releases/download/${LIBYAML_VERSION}/yaml-${LIBYAML_VERSION}.tar.gz

LIBPCAP_VERSION=1.10.7
LIBPCAP_SHA256=68fa62cffb974f4275641ce14c2e2d75739251f30e00e6a0900903b247d76a03
LIBPCAP_URL=https://www.tcpdump.org/release/libpcap-${LIBPCAP_VERSION}.tar.xz

FILE_VERSION=5.48
FILE_SHA256=ed14656883b23a364b4057c05595d93252da9bc473d30106519519d0da141283
FILE_URL=https://astron.com/pub/file/file-${FILE_VERSION}.tar.gz

# No release tarball is published; the tag archive needs autoreconf.
LIBCAP_NG_VERSION=0.9.6
LIBCAP_NG_SHA256=399040138e0ca62fa2bcabd63da9af4431a246ef7a654561a0ca3cb00010a539
LIBCAP_NG_URL=https://github.com/stevegrubb/libcap-ng/archive/refs/tags/v${LIBCAP_NG_VERSION}.tar.gz

LIBMAXMINDDB_VERSION=1.14.1
LIBMAXMINDDB_SHA256=ca5c87d41339f8bc4daabb53e8a9356b3c995f2d2419b85d7bff823b2ecc252d
LIBMAXMINDDB_URL=https://github.com/maxmind/libmaxminddb/releases/download/${LIBMAXMINDDB_VERSION}/libmaxminddb-${LIBMAXMINDDB_VERSION}.tar.gz

# Suricata 8.0's configure only accepts libnet 1.1.x/1.2.x.
LIBNET_VERSION=1.2
LIBNET_SHA256=caa4868157d9e5f32e9c7eac9461efeff30cb28357f7f6bf07e73933fb4edaa7
LIBNET_URL=https://github.com/libnet/libnet/releases/download/v${LIBNET_VERSION}/libnet-${LIBNET_VERSION}.tar.gz

VECTORSCAN_VERSION=5.4.13
VECTORSCAN_SHA256=11bfcd2dde32d8a08d1a2eebb09294b12a3fa2be140078f8091b751fa1fabd89
VECTORSCAN_URL=https://github.com/VectorCamp/vectorscan/archive/refs/tags/vectorscan/${VECTORSCAN_VERSION}.tar.gz
