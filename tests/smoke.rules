# Uses the libmagic database (with no magic-file configured, so the bundled
# magic.mgc must be found next to the executable).
alert http any any -> any any (msg:"smoke: filemagic pdf"; filemagic:"PDF document"; sid:1000001; rev:1;)
# Uses the multi-pattern matcher (Hyperscan).
alert http any any -> any any (msg:"smoke: content"; file.data; content:"%PDF-"; sid:1000002; rev:1;)
